// Cloudflare builds sundayreset.cameroncrump.com from this repo on every push to main.
// Publish only the setup page (plugins/sunday-reset/web): the rest of the plugin and the README stay on GitHub.
// The same page runs the real setup locally, so the public prototype and setup can never drift apart.
{
  "name": "sunday-reset",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./plugins/sunday-reset/web" }
}
